# Copy to .env.local for local development. Never commit real secrets.
# Docker Compose reads this file directly (see infrastructure/docker-compose.yml).

# --- Application ---
# `production`, `prod` or `staging` turns on the boot-time safety guard in
# `core/config.py`: the process refuses to start with debug on, a placeholder or short
# JWT secret, wildcard CORS, or rate limiting disabled/fail-open.
APP_ENV=local
# NEVER true outside local development. Debug mode makes Starlette return a full stack
# trace to the client on any unhandled error, bypassing the Problem Details handler.
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=fitwar
DATABASE_PASSWORD=fitwar_local_dev_password
DATABASE_NAME=fitwar
DATABASE_POOL_SIZE=5

# --- Redis ---
REDIS_URL=redis://localhost:6380/0

# --- Auth ---
# Generate a real secret for anything beyond local dev: openssl rand -hex 32
AUTH_JWT_SECRET=local-dev-only-secret-change-me-please-1234567890
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Rate limiting (Architecture §7) ---
# Sliding-window limits on abuse-prone endpoints. Defaults below are the built-in
# ones; override only if you have a reason to.
RATE_LIMIT_ENABLED=true
# Number of proxies in front of the app. 0 means X-Forwarded-For is ignored entirely
# (correct for local dev and any direct-to-app deployment). Set it to the real hop
# count once behind a load balancer, or per-IP limits become header-spoofable.
RATE_LIMIT_TRUSTED_PROXY_COUNT=0
# false = fail closed: if Redis is unreachable, throttled endpoints reject rather than
# silently run unprotected.
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_LOGIN_IP_LIMIT=20
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_ACCOUNT_LIMIT=10
RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_IP_LIMIT=10
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_IP_LIMIT=120
RATE_LIMIT_REFRESH_IP_WINDOW_SECONDS=300
RATE_LIMIT_PASSWORD_RESET_IP_LIMIT=10
RATE_LIMIT_PASSWORD_RESET_IP_WINDOW_SECONDS=3600
RATE_LIMIT_PASSWORD_RESET_ACCOUNT_LIMIT=5
RATE_LIMIT_PASSWORD_RESET_ACCOUNT_WINDOW_SECONDS=3600

# --- Media & retention (Architecture §33 — storage cost is a product constraint) ---
MEDIA_MAX_PROOF_BYTES=262144000
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_DOWNLOAD_URL_TTL_SECONDS=300
# Hours a proof video survives after it is approved or rejected. Never applies while a
# proof is still pending review — that video is protected from cleanup.
MEDIA_RESOLVED_RETENTION_HOURS=24
# An upload never attached to a submitted proof is abandoned and expires sooner.
MEDIA_ABANDONED_UPLOAD_TTL_HOURS=6

# --- Background jobs (Architecture §35) ---
# The scheduler container runs these on an interval. Both jobs are idempotent and safe
# to run concurrently with themselves, so more than one replica is harmless.
# Deadlines are per-challenge-day, so every few minutes is far finer than the rule needs.
SCHEDULER_DEADLINE_SWEEP_INTERVAL_SECONDS=300
# Retention is measured in hours, so hourly is ample.
SCHEDULER_MEDIA_CLEANUP_INTERVAL_SECONDS=3600
# JSON list. Set to ["deadline_sweep","media_cleanup"] when a platform-native scheduler
# (Kubernetes CronJob, ECS scheduled task) runs `python -m app.workers.<job>` instead of
# this container.
SCHEDULER_DISABLED_JOBS=[]

# --- Storage (S3-compatible; not wired to any endpoint until the Media phase) ---
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=fitwar-media
STORAGE_ACCESS_KEY_ID=fitwar_local
STORAGE_SECRET_ACCESS_KEY=fitwar_local_dev_secret
